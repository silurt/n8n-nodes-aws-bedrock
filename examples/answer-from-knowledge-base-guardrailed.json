{
  "name": "Answer from a Bedrock knowledge base, guardrailed",
  "nodes": [
    {
      "id": "a1",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -180,
        0
      ],
      "parameters": {}
    },
    {
      "id": "a2",
      "name": "Customer question",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        40,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "q",
              "name": "question",
              "value": "Which documents cover our refund policy for EU customers?",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a3",
      "name": "Answer from knowledge base",
      "type": "n8n-nodes-aws-bedrock.awsBedrock",
      "typeVersion": 1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "resource": "knowledgeBase",
        "operation": "retrieveAndGenerate",
        "knowledgeBaseId": "KB12345678",
        "query": "={{ $json.question }}",
        "modelArn": "arn:aws:bedrock:eu-central-1::foundation-model/anthropic.claude-sonnet-4-20250514-v1:0",
        "options": {}
      }
    },
    {
      "id": "a4",
      "name": "Check answer against guardrail",
      "type": "n8n-nodes-aws-bedrock.awsBedrock",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "guardrail",
        "operation": "apply",
        "guardrailIdentifier": "gr-example",
        "guardrailVersion": "DRAFT",
        "text": "={{ $json.output.text }}",
        "source": "OUTPUT",
        "guardrailOptions": {
          "outputScope": "FULL"
        }
      }
    },
    {
      "id": "a5",
      "name": "Guardrail intervened?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.action }}",
              "rightValue": "GUARDRAIL_INTERVENED"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a6",
      "name": "Send to a human",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        940,
        -110
      ],
      "parameters": {}
    },
    {
      "id": "a7",
      "name": "Reply to the customer",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        940,
        110
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "When clicking 'Execute workflow'": {
      "main": [
        [
          {
            "node": "Customer question",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Customer question": {
      "main": [
        [
          {
            "node": "Answer from knowledge base",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Answer from knowledge base": {
      "main": [
        [
          {
            "node": "Check answer against guardrail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check answer against guardrail": {
      "main": [
        [
          {
            "node": "Guardrail intervened?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardrail intervened?": {
      "main": [
        [
          {
            "node": "Send to a human",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reply to the customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
