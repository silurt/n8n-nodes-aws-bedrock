{
  "name": "@silurt/n8n-nodes-aws-bedrock",
  "version": "0.2.0",
  "description": "n8n node for Amazon Bedrock knowledge bases and guardrails: retrieve, retrieve-and-generate, and apply guardrail.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "aws",
    "bedrock",
    "knowledge-base",
    "rag",
    "guardrails"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/silurt/n8n-nodes-aws-bedrock",
  "author": {
    "name": "Simon Rothert",
    "email": "puresamari@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silurt/n8n-nodes-aws-bedrock.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --test test/*.test.mjs",
    "check:signing": "node test/sigv4-check.mjs",
    "pretest": "npm run build",
    "check:live": "node test/live-check.mjs",
    "check:wire": "node test/wire/mock-bedrock.mjs & sleep 1; node test/wire/wire-check.mjs; kill %1"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/AwsBedrock/AwsBedrock.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "n8n-workflow": "^2",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "n8n-workflow": "^2"
  }
}
